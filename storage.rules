rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile pictures: anyone signed in can view (needed for restaurant
    // list, delivery live tracking, etc.), but a user can only upload/replace
    // their OWN picture - enforced by the filename having to match their uid.
    match /profile_images/{role}/{fileName} {

      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg';
    }

    // Everything else stays locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
