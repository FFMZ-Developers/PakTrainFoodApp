<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ============ RESTAURANT FIELDS ============ -->
        <LinearLayout
            android:id="@+id/group_restaurant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Restaurant Name"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_restaurant_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:inputType="textCapWords"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Restaurant Address"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_restaurant_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:inputType="textPostalAddress"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="City"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinner_city"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/edittext_bg"
                android:padding="12dp" />

            <!-- Module: restaurant location (needed for real rider routing) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Restaurant Location"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txt_restaurant_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_bg"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:padding="12dp"
                android:text="Not set - tap below to use your current location" />

            <Button
                android:id="@+id/btn_capture_location"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/teal_700"
                android:text="Use My Current Location"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <!-- Module: restaurant opening hours -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Opening Hours"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_wizard_opening_time"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/edittext_bg"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="Opens: 10:00 AM" />

                <TextView
                    android:id="@+id/txt_wizard_closing_time"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/edittext_bg"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="Closes: 10:00 PM" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Food Authority License Number"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_license_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:hint="e.g. PFA-2024-XXXXX"
                android:inputType="text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="License Document Photo"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_license"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/img_license"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/edittext_bg" />

                    <TextView
                        android:id="@+id/txt_license_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Tap to add license photo"
                        android:textColor="@color/text_hint"
                        android:textSize="13sp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ============ RIDER FIELDS ============ -->
        <LinearLayout
            android:id="@+id/group_rider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Address"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_rider_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:inputType="textPostalAddress"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="City"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinner_rider_city"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/edittext_bg"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Driving License Number"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_driving_license_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:inputType="text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Driving License Photo"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_driving_license"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/img_driving_license"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/edittext_bg" />

                    <TextView
                        android:id="@+id/txt_driving_license_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Tap to add license photo"
                        android:textColor="@color/text_hint"
                        android:textSize="13sp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bike Registration Number"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_vehicle_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:hint="e.g. LEA-1234"
                android:inputType="textCapCharacters"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bike Photo (number plate visible)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_bike"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/img_bike"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/edittext_bg" />

                    <TextView
                        android:id="@+id/txt_bike_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Tap to add bike photo, number plate visible"
                        android:textColor="@color/text_hint"
                        android:textSize="13sp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <Button
            android:id="@+id/btn_step2_next"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="Next"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/teal_700" />

    </LinearLayout>
</ScrollView>
