<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F6F6">

    <!-- APP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/teal_700"
        android:elevation="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@android:color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Live Order Tracking"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- TOP MAP (40% SCREEN HEIGHT APPROX) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- BOTTOM CONTENT (60%) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:padding="16dp">

        <!-- IMPORTANT: ONLY ONE CHILD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ETA CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:elevation="4dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/txtCurrentStation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Station:"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000" />
                <TextView
                    android:id="@+id/txtEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Time: --"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000" />

                <!-- Module: rider live route/ETA (Google Directions API) -->
                <TextView
                    android:id="@+id/txtRiderEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:visibility="gone" />

                <!-- Hands off to the Google Maps app for real turn-by-turn
                     guidance (see startNavigation()). -->
                <Button
                    android:id="@+id/btnNavigate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#1565C0"
                    android:text="Start Navigation"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Module: contact the other party for this order.
                     Which counterparty this points at depends on the
                     order's stage - see setupContactButtons(). -->
                <LinearLayout
                    android:id="@+id/layoutContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtContactWith"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <ImageView
                        android:id="@+id/btnChat"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="10dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_circle_teal"
                        android:src="@drawable/ic_chat"
                        android:contentDescription="Chat" />

                    <ImageView
                        android:id="@+id/btnCall"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_circle_green"
                        android:src="@drawable/ic_call"
                        android:contentDescription="Call" />
                </LinearLayout>
            </LinearLayout>

            <!-- ORDER ITEMS CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:elevation="4dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Items"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#000"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/txtTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: Rs 0"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#009688"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>
            <!-- TRAIN INFO CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:elevation="4dp"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTrainName"
                    android:text="Train:"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    />
                <TextView android:id="@+id/txtTicketNumber" android:text="Ticket:"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
                <TextView android:id="@+id/txtSeatNumber" android:text="Seat:"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
                <TextView android:id="@+id/txtCoachNumber" android:text="Coach:"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
                <TextView android:id="@+id/txtPhone" android:text="Phone:"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
                <TextView android:id="@+id/txtMealStation" android:text="Station:"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>



















