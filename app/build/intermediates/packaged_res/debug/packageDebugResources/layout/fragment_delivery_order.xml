<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".ui.main.Delivery.order.DeliveryOrderFragment">

    <!-- Toolbar (same look as Restaurant / Passenger order screens) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/Toolbar_Delivery_Orders"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:title="My Orders"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/Toolbar.Title" />

    <!-- Header Image (deliveryboy.png is an icon-style illustration, not a
         full-bleed photo like order1.jpg / logo5.jpg, so it sits on a tinted
         backdrop with centerInside rather than being cropped edge-to-edge) -->
    <ImageView
        android:id="@+id/headerImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@drawable/order1"/>

    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs_delivery_Orders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/half_white"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/colorPrimary"
        app:tabTextColor="@color/black" />

    <!-- Container for Tab Fragments -->
    <FrameLayout
        android:id="@+id/delivery_orders_tab_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp" />

</LinearLayout>



